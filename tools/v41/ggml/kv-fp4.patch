+// Strata DS4.1 --kv-fp4: NVFP4 rows for get_rows (a QK_K super-block = 4 NVFP4 blocks; 32 threads x 8 values).
+// Same values as dequantize_block_nvfp4 (convert.cu): ue4m3(d) (= E4M3 / 2) x kvalues (= 2 x e2m1) - exact.
+template<typename dst_t>
+static __device__ __forceinline__ void dequantize_nvfp4(const void * vx, const int64_t ibs, dst_t * yy, const int tid) {
+    const block_nvfp4 * x = (const block_nvfp4 *) vx + ibs*(QK_K/QK_NVFP4);
+    const int b  = tid/8;        // block 0..3
+    const int sb = (tid%8)/2;    // sub-block 0..3
+    const int h  = tid%2;        // bytes 0-3 / 4-7 of the sub-block
+    const block_nvfp4 & xb = x[b];
+    const float d = ggml_cuda_ue4m3_to_fp32(xb.d[sb]);
+    const uint8_t * q = xb.qs + sb*(QK_NVFP4_SUB/2) + 4*h;
+    dst_t * y = yy + b*QK_NVFP4 + sb*QK_NVFP4_SUB + 4*h;
+    for (int j = 0; j < 4; ++j) {
+        y[j]                  = ggml_cuda_cast<dst_t>(d * kvalues_mxfp4[q[j] & 0x0F]);
+        y[j + QK_NVFP4_SUB/2] = ggml_cuda_cast<dst_t>(d * kvalues_mxfp4[q[j] >> 4]);
+    }
+}
