#!/bin/bash
# ============================================================================
# STRATA-DS41-QUETZA - DeepSeek-V4.1-Flash (uncensored, GSQ mixed tiers) on the Strata-DS4 engine, QuetzaCodetl in front
#
# Engine:  build-ds4-gpu/ds41_generate --serve (Strata's engine line protocol) via tools/v41/serve/ds41-engine.sh
#          (shared GPU lock with strata-glm, 84 GiB RAM cap, refuses while ComfyUI runs).  Defaults (2026-10-15):
#          route bias x0.5 + file 0.3 + --arena-adapt (HumanEval 20/21, tools 10/10), DSpark speculative decode
#          (exact sampling, confidence trim 0.6) ~17-30 tok/s, --kv-fp4 (bit-exact 4-bit KV), long prompts
#          layer-major (~250 tok/s, exact), turns <= 96 new tokens as exact passes, bigger turns ~19 s at 512K
# Server:  Strata's serve.server through tools/v41/serve/serve_ds41.py (DeepSeek encoder, DSML tool calls,
#          reasoning effort 1-100) - OpenAI (/v1) + Anthropic (/v1/messages) + /health + llama.cpp-style /metrics
# Context: 524288 (V4.1's caches are shared across layers: ~1.5 GB at 512K)
# Usage:   strata-ds41-quetza [--port=N] [-- <quetza args>]
# ============================================================================
set -eE
WRAPPER_NAME="strata-ds41-quetza"
# 2026-10-16: repointed to the unified Xolotl tree (pre-Xolotl copy: strata-ds41-quetza.bak-prexolotl-20261016)
DS_DIR="/home/mal/AI/Xolotl"
PY="/home/mal/AI/Strata/.venv/bin/python"
SHIM="$DS_DIR/tools/v41/serve/serve_ds41.py"
CONFIG="$DS_DIR/tools/v41/serve/strata-ds41.json"
CONTEXT_SIZE=524288
LOCAL_HOST="127.0.0.1"
LOCAL_PORT=8150
MODEL_NAME="deepseek-v4.1-flash-strata-gsq"
QUETZA_ARGS=()
for arg in "$@"; do
    case "$arg" in
        --port=*) LOCAL_PORT="${arg#--port=}" ;;
        *)        QUETZA_ARGS+=("$arg") ;;
    esac
done
LOCAL_URL="http://$LOCAL_HOST:$LOCAL_PORT"
SERVER_LOG="/tmp/strata-ds41-quetza-$LOCAL_PORT.log"
SERVER_PID_FILE="/tmp/strata-ds41-quetza-$LOCAL_PORT.pid"

log_info() { echo -e "\033[1;34m[INFO]\033[0m $*"; }
log_ok()   { echo -e "\033[1;32m[+]\033[0m $*"; }
log_err()  { echo -e "\033[1;31m[ERROR]\033[0m $*"; }

CLEANED=false
cleanup() {
    [ "$CLEANED" = true ] && return
    CLEANED=true
    if [ -f "$SERVER_PID_FILE" ]; then
        local pid; pid=$(cat "$SERVER_PID_FILE" 2>/dev/null || true)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            kill -- -"$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
            sleep 2
            kill -9 -- -"$pid" 2>/dev/null || true
            log_ok "stopped Strata-DS41 (pid $pid); GPU lock released"
        fi
        rm -f "$SERVER_PID_FILE"
    fi
}
trap cleanup EXIT INT TERM

if curl -s --max-time 2 "$LOCAL_URL/health" >/dev/null 2>&1; then
    log_ok "Strata-DS41 already running at $LOCAL_URL - attaching"
else
    [ -x "$PY" ] || { log_err "missing $PY (Strata venv)"; exit 1; }
    [ -x "$DS_DIR/build-ds4-gpu/ds41_generate" ] || { log_err "missing build-ds4-gpu/ds41_generate"; exit 1; }
    if ss -ltn 2>/dev/null | grep -q ':8188 '; then
        log_err "ComfyUI is running on :8188 - stop it first (the engine needs ~80 GB RAM)"; exit 1
    fi
    if ! flock -n "$HOME/.quetza-data/conductor/ds4-gpu.lock" true; then
        log_info "the GPU lock is held (strata-glm or a DS4 job?) - the engine will wait for it"
    fi
    log_info "Starting Strata-DS41 on $LOCAL_URL ..."
    log_info "  config: $CONFIG"
    setsid "$PY" "$SHIM" --engine strata --config "$CONFIG" --host "$LOCAL_HOST" --port "$LOCAL_PORT" \
        > "$SERVER_LOG" 2>&1 < /dev/null &
    echo $! > "$SERVER_PID_FILE"
    server_pid=$(cat "$SERVER_PID_FILE")
    log_info "  pid $server_pid - log $SERVER_LOG (engine log: /tmp/strata-ds41.log; load ~1 min: 60 GiB RAM arena fill)"
    for i in $(seq 1 450); do
        if curl -s --max-time 2 "$LOCAL_URL/health" >/dev/null 2>&1; then
            log_ok "ready: $LOCAL_URL/v1 (OpenAI) - $LOCAL_URL/v1/messages (Anthropic)"
            break
        fi
        if ! kill -0 "$server_pid" 2>/dev/null; then
            log_err "server died during load; tail of $SERVER_LOG:"; tail -15 "$SERVER_LOG" 2>/dev/null
            tail -15 /tmp/strata-ds41.log 2>/dev/null
            exit 1
        fi
        sleep 2
    done
fi

QUETZA_DIR="/home/mal/AI/QuetzaCodetl"
cd "$QUETZA_DIR" || exit 1
log_ok "Starting QuetzaCodetl ..."
log_info "  endpoint: $LOCAL_URL - model: $MODEL_NAME - context: $((CONTEXT_SIZE / 1024))K"
env \
    -u MODEL_NAME -u LOCAL_MODEL_NAME \
    QUETZA_LOCAL_MODE=1 \
    QUETZA_CODE_REPL=1 \
    QUETZA_NATIVE_TOOLS=1 \
    QUETZA_EXPERIMENTAL_DEFER_TOOLS=1 \
    QUETZA_MAX_OUTPUT_TOKENS="${QUETZA_MAX_OUTPUT_TOKENS:-32768}" \
    BASH_MAX_OUTPUT_LENGTH="${BASH_MAX_OUTPUT_LENGTH:-12000}" \
    TASK_MAX_OUTPUT_LENGTH="${TASK_MAX_OUTPUT_LENGTH:-12000}" \
    ENABLE_TOOL_SEARCH=false \
    QUETZA_ENDPOINT="$LOCAL_URL" \
    QUETZA_CONTEXT_SIZE="$CONTEXT_SIZE" \
    QUETZA_MODEL_NAME="$MODEL_NAME" \
    ANTHROPIC_BASE_URL="$LOCAL_URL" \
    ANTHROPIC_API_KEY="local-dummy-key" \
    COLORTERM=truecolor \
    DISABLE_TELEMETRY=1 \
    DISABLE_AUTO_UPDATE=1 \
    SKIP_HOOKS=1 \
    bun ./dist/cli.mjs "${QUETZA_ARGS[@]}"
EXIT_CODE=$?
log_info "QuetzaCodetl exited with code $EXIT_CODE"
exit $EXIT_CODE
